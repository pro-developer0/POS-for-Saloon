# --- Required in production ---
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# PostgreSQL (production). If unset, an embedded dev database is stored in .data/pglite
# DATABASE_URL=postgres://user:password@host:5432/salonpro

# --- Email (optional). Without SMTP_URL, emails are written to .data/outbox.log (dev) ---
# Public URL used in reset/verify links. REQUIRED in production (links are not sent without it).
# APP_URL=https://app.yourdomain.com
# Any SMTP account works, e.g. a free-tier provider:  SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="SalonPro <no-reply@yourdomain.com>"

# Hosted Postgres (Supabase etc.): SSL is on automatically; set DATABASE_SSL=false only for a plain local server.
# DATABASE_POOL_MAX=3   # keep small on Vercel/serverless

# --- Optional: file uploads directory (default ./uploads) ---
# UPLOAD_DIR=uploads

# --- Optional FREE-ONLY AI (the app works fully without any of these) ---
# Local AI (no cost): install Ollama, run `ollama pull llama3.2:3b`
OLLAMA_URL=http://localhost:11434
# Free-tier cloud keys (verify each provider's current free quota + commercial terms; NEVER enable billing):
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=   # only ':free' models are accepted by the code
